# Copy to secrets.yaml and fill in your own values. Never commit secrets.yaml.
wifi_ssid: "your-network"
wifi_password: "your-password"
# 8 digits, entered in Music Assistant when pairing
sendspin_pairing_code: "12345678"
# Base64 of 32 random bytes. Generate one at https://esphome.io/components/api/
api_encryption_key: "paste-your-generated-key-here"
